[Unit]
Description=OrcaHub (compiled OTP release)
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{HOME}}/orca-hub-releases/current
EnvironmentFile={{HOME}}/orca-hub-releases/.env
Environment="PATH={{HOME}}/.local/share/mise/shims:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PHX_SERVER=true"
ExecStart={{HOME}}/orca-hub-releases/current/bin/orca_hub start
Restart=on-failure
RestartSec=5

# Give the BEAM VM time to shut down gracefully
TimeoutStopSec=30

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orca-hub

# Memory limits — BEAM peaks observed around 2.2G
MemoryHigh=2500M
MemoryMax=3G

# Basic hardening. Further hardening (ProtectSystem=strict, ProtectHome=read-only,
# ReadWritePaths=...) is deferred — the app writes to ~/.claude, project
# directories, and other paths that need careful enumeration first.
NoNewPrivileges=yes
PrivateDevices=yes

# DELIBERATELY NOT SET: PrivateTmp=yes (removed 2026-09-21). Do not re-add it
# as "hardening" — it was weighed and rejected:
#   * It guards nothing that matters here. This unit runs as an ordinary
#     login user with no ProtectHome, so the process already has full
#     read/write access to ~/.ssh, ~/.kube and every checkout on the box.
#     Isolating /tmp locks the least valuable door in a house whose front
#     door is standing open.
#   * It actively breaks two things. Agent sessions run inside THIS unit's
#     process tree, so every /tmp path an agent reports to a human is wrong:
#     it really resolves under /tmp/systemd-private-*/tmp/ and does not
#     exist at the path the human was told to look at. And a deploy driven
#     from inside a session writes its build artifact into that private
#     /tmp, which is torn down with the deploy's process tree — the artifact
#     cannot outlive the deploy that produced it.
# NoNewPrivileges=yes above STAYS: it is load-bearing, and the
# `ssh localhost 'sudo -n systemctl restart orca-hub'` escape it forces is
# already built and documented (deploy-orca-hub.sh, Step 7).

[Install]
WantedBy=multi-user.target
