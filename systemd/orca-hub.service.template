[Unit]
Description=OrcaHub (compiled OTP release)
After=network-online.target
Wants=network-online.target
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{HOME}}/orca-hub-releases/current
EnvironmentFile={{HOME}}/orca-hub-releases/.env
Environment="PATH={{HOME}}/.local/share/mise/shims:{{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PHX_SERVER=true"
ExecStart={{HOME}}/orca-hub-releases/current/bin/orca_hub start
Restart=on-failure
RestartSec=5

# Give the BEAM VM time to shut down gracefully
TimeoutStopSec=30

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orca-hub

# Memory limits for the WHOLE unit: the BEAM plus every agent CLI it runs and
# everything those start (cargo, ffmpeg, browsers). Per host, rendered by
# install.sh (--memory-high/--memory-max/--memory-swap-max; it keeps the
# installed unit's values when no flag is given, so a reinstall never reverts
# a host's tuning). The BEAM itself is ~100-150M resident; the old "BEAM peaks
# around 2.2G" figure was this whole cgroup.
#
# MemoryHigh defaults to infinity. A soft limit far below the hard one is what
# turned 2026-10-11's runaway `cargo test` on gb10 into an 11-hour stall at
# ~96% memory pressure with no OOM kill ever (ORCAHUB3-145): kill, don't stall.
# Agent CLIs have their own, lower limits inside the unit (Delegate= below), so
# this cap is the backstop for the BEAM's own side.
MemoryHigh={{MEMORY_HIGH}}
MemoryMax={{MEMORY_MAX}}
MemorySwapMax={{MEMORY_SWAP_MAX}}

# Agent CLI isolation (OrcaHub.ProcessIsolation, ORCAHUB3-145/146). The unit's
# cgroup is delegated to {{USER}} and the BEAM starts in its `beam` child, so
# the BEAM can run each agent CLI spawn in its own sibling cgroup
# (orca-hub.service/agents/<spawn>/) with its own memory.max, memory.swap.max
# and pids.max, and cgroup.kill the whole tree when the session's port goes
# away. The ORCA_AGENT*_ env vars in the .env tune those limits (see
# config/runtime.exs). The subgroup name is load-bearing: the BEAM only uses
# delegation when its own cgroup is named `beam`. Without these two lines
# agent trees are still killed on teardown, by env marker, but get no limits.
# DelegateSubgroup= needs systemd >= 254 (install.sh checks).
Delegate=yes
DelegateSubgroup=beam

# Basic hardening. Further hardening (ProtectSystem=strict, ProtectHome=read-only,
# ReadWritePaths=...) is deferred — the app writes to ~/.claude, project
# directories, and other paths that need careful enumeration first.
NoNewPrivileges=yes
# Per host (install.sh --private-devices, kept from the installed unit by
# default). `yes` hides hardware device nodes, GPUs included, from the BEAM
# and every agent it runs; gb10's unit has always run without it.
PrivateDevices={{PRIVATE_DEVICES}}

# DELIBERATELY NOT SET: PrivateTmp=yes (removed 2026-09-21). Do not re-add it
# as "hardening" — it was weighed and rejected:
#   * It guards nothing that matters here. This unit runs as an ordinary
#     login user with no ProtectHome, so the process already has full
#     read/write access to ~/.ssh, ~/.kube and every checkout on the box.
#     Isolating /tmp locks the least valuable door in a house whose front
#     door is standing open.
#   * It actively breaks two things. Agent sessions run inside THIS unit's
#     process tree, so every /tmp path an agent reports to a human is wrong:
#     it really resolves under /tmp/systemd-private-*/tmp/ and does not
#     exist at the path the human was told to look at. And a deploy driven
#     from inside a session writes its build artifact into that private
#     /tmp, which is torn down with the deploy's process tree — the artifact
#     cannot outlive the deploy that produced it.
# NoNewPrivileges=yes above STAYS: it is load-bearing, and the
# `ssh localhost 'sudo -n systemctl restart orca-hub'` escape it forces is
# already built and documented (deploy-orca-hub.sh, Step 7).

[Install]
WantedBy=multi-user.target
