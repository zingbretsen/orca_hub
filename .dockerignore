_build/
deps/
# The Dockerfile runs `npm --prefix assets ci`, which deletes and rebuilds
# assets/node_modules from the lockfile anyway — so shipping the host's copy in
# the build context is pure waste. It stopped being cheap waste when voice mode
# added onnxruntime-web: 137 MB of it (every wasm/webgpu/jspi build variant),
# taking the context from ~10 MB to ~158 MB, on a build that streams the context
# to a REMOTE buildx node (gb10) over ssh for the arm64 half.
assets/node_modules/
doc/
cover/
tmp/
log/

.env
*.db
*.db-*
*.ez
erl_crash.dump

# Git
.git/
.gitignore

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Claude local settings
.claude/
.agents/
plan.md
.worktree_cache/

# Test artifacts
test-results/

# Uploaded files / screenshots
upload_*
*.png

# Generated inside the image build (echo "$GIT_SHA" > priv/git_sha) —
# excluded so a stray local copy can never ride into the build context and
# get COPYed in before the Dockerfile's own RUN overwrites it with the real
# value for this build.
priv/git_sha
