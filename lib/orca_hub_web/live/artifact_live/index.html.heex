<.header>
  Artifacts
</.header>

<div class="flex flex-wrap items-center gap-3 mt-4">
  <form phx-change="filter_name" class="flex-1 min-w-48">
    <input
      type="text"
      name="name"
      value={@name_filter}
      placeholder="Filter by name…"
      phx-debounce="150"
      class="input input-bordered input-sm w-full"
    />
  </form>
  <form phx-change="filter_project">
    <select name="project_id" class="select select-bordered select-sm">
      <option value="">All projects</option>
      <option
        :for={project <- @projects}
        value={project.id}
        selected={@project_filter == project.id}
      >
        {project.name}
      </option>
    </select>
  </form>
</div>

<.grouped_index
  id="artifacts"
  groups={@grouped_artifacts}
  pinned={@pinned_artifacts}
  row_click={fn artifact -> JS.navigate(~p"/artifacts/#{artifact.id}") end}
  empty_message={empty_message()}
>
  <:col :let={artifact} label="" class="w-8">
    <button
      type="button"
      phx-click={if artifact.pinned_at, do: "unpin", else: "pin"}
      phx-value-id={artifact.id}
      class="btn btn-ghost btn-xs btn-circle"
      title={if artifact.pinned_at, do: "Unpin", else: "Pin"}
    >
      <.icon
        name={if artifact.pinned_at, do: "hero-star-solid", else: "hero-star"}
        class={if artifact.pinned_at, do: "size-4 text-warning", else: "size-4 text-base-content/40"}
      />
    </button>
  </:col>
  <:col :let={artifact} label="Name" class="w-2/5">
    <.link navigate={~p"/artifacts/#{artifact.id}"} class="link link-hover">
      {artifact.name}
    </.link>
  </:col>
  <:col :let={artifact} label="Kind" class="w-1/5">
    <span class="badge badge-sm badge-outline">{artifact.kind}</span>
  </:col>
  <:col :let={artifact} label="Version" class="w-1/5">v{artifact.version}</:col>
  <:col :let={artifact} label="Updated" class="w-1/5 whitespace-nowrap text-xs text-base-content/60">
    {Calendar.strftime(artifact.updated_at, "%b %d, %H:%M")}
  </:col>
  <:action :let={artifact}>
    <.link
      phx-click="delete"
      phx-value-id={artifact.id}
      data-confirm="Delete this artifact? This cannot be undone."
    >
      Delete
    </.link>
  </:action>
</.grouped_index>
