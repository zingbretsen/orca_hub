<.header>
  <div class="flex items-center gap-3 min-w-0">
    <button
      onclick="history.back()"
      class="btn btn-ghost btn-sm btn-circle"
      title="Back"
    >
      <.icon name="hero-arrow-left-micro" class="size-5" />
    </button>
    <span class="truncate font-semibold">{@artifact.name}</span>
    <span class="badge badge-sm badge-outline">{@artifact.kind}</span>
    <span class="badge badge-sm badge-ghost">v{@artifact.version}</span>
  </div>
  <:actions>
    <button
      :if={@project}
      phx-click="open_edit_session"
      class="btn btn-sm btn-primary gap-1"
    >
      <.icon name="hero-pencil-square-micro" class="size-4" /> Edit in session
    </button>
    <.link
      href={~p"/artifacts/#{@artifact.id}/download"}
      download
      class="btn btn-sm btn-ghost gap-1"
      title="Download artifact"
    >
      <.icon name="hero-arrow-down-tray-micro" class="size-4" /> Download
    </.link>
    <.link
      :if={@project}
      navigate={~p"/projects/#{@project.id}"}
      class="btn btn-sm btn-ghost gap-1"
    >
      <.icon name="hero-folder-micro" class="size-4" /> {@project.name}
    </.link>
  </:actions>
</.header>

<div class="mt-3 flex items-center gap-1">
  <button
    :for={{key, label} <- [{"mobile", "Mobile"}, {"tablet", "Tablet"}, {"full", "Full"}]}
    phx-click="set_viewport"
    phx-value-viewport={key}
    class={["btn btn-xs", @viewport == key && "btn-primary", @viewport != key && "btn-ghost"]}
  >
    {label}
  </button>
</div>

<div
  id="artifact-fullscreen-wrapper"
  phx-hook="ArtifactFullscreen"
  class="mt-3 flex justify-center bg-base-200 rounded-lg p-2 h-[calc(100vh-14rem)] relative artifact-fs-wrapper"
>
  <button
    data-artifact-fullscreen-btn
    class="btn btn-xs btn-ghost gap-1 absolute top-2 right-2 z-10"
    title="Toggle fullscreen"
  >
    <.icon name="hero-arrows-pointing-out-micro" class="size-3" />
  </button>
  <iframe
    id="artifact-fullscreen-frame"
    src={raw_src(@artifact)}
    sandbox="allow-scripts"
    title={@artifact.name}
    phx-hook="ArtifactData"
    data-artifact-id={@artifact.id}
    class="h-full bg-white rounded border border-base-300"
    style={
      if width = viewport_width(@viewport),
        do: "width: #{width}px; max-width: 100%;",
        else: "width: 100%;"
    }
  />
</div>

<%!-- "Edit in session" modal — starts a new session pointed at this artifact --%>
<div
  :if={@show_edit_session}
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-black/50"
>
  <div class="card bg-base-100 shadow-xl w-full max-w-lg p-4 sm:p-6 rounded-b-none sm:rounded-b-2xl">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold">Edit in session</h2>
      <button phx-click="close_edit_session" class="btn btn-ghost btn-sm btn-circle">
        <.icon name="hero-x-mark" class="size-5" />
      </button>
    </div>

    <p class="text-sm text-base-content/60 mb-4">
      Starts a new session pointed at "{@artifact.name}" with your requested change.
    </p>

    <form phx-submit="start_edit_session" class="space-y-4">
      <textarea
        name="instruction"
        rows="4"
        autofocus
        placeholder="e.g. add a total row to the table"
        class="textarea textarea-bordered w-full"
      ></textarea>
      <div class="flex justify-end gap-2">
        <button type="button" phx-click="close_edit_session" class="btn btn-ghost">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary">
          Start session
        </button>
      </div>
    </form>
  </div>
</div>
