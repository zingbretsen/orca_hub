<.header>
  Settings
</.header>

<div class="mt-8">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">MCP Servers</h3>
    <div class="flex gap-2">
      <button
        phx-click="refresh_connections"
        class="btn btn-sm btn-ghost"
        title="Refresh connections"
      >
        <.icon name="hero-arrow-path-micro" class="size-4" />
      </button>
      <.link patch={~p"/settings/upstream/new"}>
        <.button class="btn-sm">Add Server</.button>
      </.link>
    </div>
  </div>

  <p class="text-sm text-base-content/60 mb-4">
    Define MCP servers here and add them to specific projects or sessions from their pages.
    Servers marked as <strong>global</strong>
    are also aggregated into OrcaHub's MCP endpoint and available to every session automatically.
    Tools from global servers are namespaced with a prefix to avoid conflicts.
  </p>

  <div :if={@show_form} class="card bg-base-200 p-4 mb-6">
    <h4 class="font-semibold mb-3">
      {if @editing_server, do: "Edit Server", else: "Add MCP Server"}
    </h4>
    <.form for={@form} phx-submit="save" phx-change="validate" class="space-y-3">
      <.input
        field={@form[:name]}
        type="text"
        label="Name"
        placeholder="My MCP Server"
        phx-debounce="blur"
      />
      <.input
        field={@form[:url]}
        type="text"
        label="URL"
        placeholder="https://example.com/mcp"
        phx-debounce="blur"
      />
      <.input
        field={@form[:prefix]}
        type="text"
        label="Tool prefix"
        placeholder="Auto-generated from name"
        phx-debounce="blur"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        Tools will be exposed as <code class="bg-base-300 px-1 rounded">prefix__tool_name</code>
      </p>
      <.input field={@form[:global]} type="checkbox" label="Available to all sessions (global)" />
      <p class="text-xs text-base-content/50 -mt-2">
        When enabled, this server is automatically included in every session via OrcaHub's MCP proxy.
        Uncheck to only use this server in specific projects or sessions.
      </p>
      <.input
        field={@form[:session_scoped]}
        type="checkbox"
        label="Separate upstream session per Orca session"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        For stateful servers (e.g. Playwright): each Orca session gets its own upstream MCP
        session — its own browser context — instead of sharing one.
      </p>
      <.input
        field={@form[:secret_injection]}
        type="checkbox"
        label="Inject OrcaHub secrets into calls to this server"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        When enabled, any argument value that exactly matches a secret key name (see
        <strong>Secrets</strong>
        below) is replaced with the real value before the call is forwarded upstream, and
        every occurrence of a secret value (plus common encodings) is masked out of this
        server's tool responses.
      </p>

      <div>
        <label class="label"><span class="label-text">Headers</span></label>
        <p class="text-xs text-base-content/50 mb-2">
          Add authentication headers or other custom headers for the upstream server.
        </p>
        <div class="space-y-2">
          <div
            :for={{pair, idx} <- Enum.with_index(@header_pairs)}
            class="flex items-center gap-2"
          >
            <input
              type="text"
              name={"header_keys[#{idx}]"}
              value={pair.key}
              placeholder="Header name"
              phx-debounce="blur"
              class="input input-sm input-bordered flex-1"
            />
            <input
              type="text"
              name={"header_values[#{idx}]"}
              value={pair.value}
              placeholder="Header value"
              phx-debounce="blur"
              class="input input-sm input-bordered flex-1"
            />
            <button
              type="button"
              phx-click="remove_header"
              phx-value-index={idx}
              class="btn btn-sm btn-ghost text-error"
            >
              <.icon name="hero-x-mark-micro" class="size-4" />
            </button>
          </div>
        </div>
        <button type="button" phx-click="add_header" class="btn btn-xs btn-ghost mt-2">
          + Add header
        </button>
      </div>

      <div class="flex justify-end gap-2 mt-4">
        <.link patch={~p"/settings"} class="btn btn-sm">Cancel</.link>
        <.button type="submit" class="btn-sm">
          {if @editing_server, do: "Update", else: "Add"}
        </.button>
      </div>
    </.form>
  </div>

  <div
    :if={@servers == [] && !@show_form}
    class="text-sm text-base-content/50 p-8 text-center bg-base-200 rounded-lg"
  >
    No MCP servers configured.
  </div>

  <div
    :if={@servers != []}
    class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden"
  >
    <div
      :for={server <- @servers}
      class="flex items-center gap-3 px-4 py-3 text-sm hover:bg-base-300/50"
    >
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-medium">{server.name}</span>
          <span class={[
            "badge badge-xs",
            if(server.enabled, do: "badge-success", else: "badge-ghost")
          ]}>
            {if server.enabled, do: "enabled", else: "disabled"}
          </span>
          <span :if={server.global} class="badge badge-xs badge-neutral">global</span>
          <span :if={server.session_scoped} class="badge badge-xs badge-accent">
            session-scoped
          </span>
          <span
            :if={server.secret_injection}
            class="badge badge-xs badge-warning gap-1"
            title="OrcaHub secrets are injected into calls and masked from responses"
          >
            <.icon name="hero-key-micro" class="size-3" /> secret injection
          </span>
          <span :if={server.enabled && server.global} class="badge badge-xs badge-info">
            {tool_count_for_server(@upstream_tools, server)} tools
          </span>
        </div>
        <div class="text-base-content/50 text-xs mt-0.5 font-mono truncate">{server.url}</div>
        <div class="text-base-content/40 text-xs mt-0.5">
          Prefix: <code class="bg-base-300 px-1 rounded">{server.prefix}</code>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button
          phx-click="toggle"
          phx-value-id={server.id}
          class="btn btn-xs btn-ghost"
          title={if server.enabled, do: "Disable", else: "Enable"}
        >
          <.icon
            name={if server.enabled, do: "hero-pause-micro", else: "hero-play-micro"}
            class="size-4"
          />
        </button>
        <button
          phx-click="toggle_global"
          phx-value-id={server.id}
          class="btn btn-xs btn-ghost"
          title={if server.global, do: "Make project/session-only", else: "Make global"}
        >
          <.icon
            name={if server.global, do: "hero-globe-alt-micro", else: "hero-lock-closed-micro"}
            class="size-4"
          />
        </button>
        <.link
          patch={~p"/settings/upstream/#{server.id}/edit"}
          class="btn btn-xs btn-ghost"
          title="Edit"
        >
          <.icon name="hero-pencil-micro" class="size-4" />
        </.link>
        <button
          phx-click="delete"
          phx-value-id={server.id}
          data-confirm="Remove this upstream server?"
          class="btn btn-xs btn-ghost text-error"
          title="Delete"
        >
          <.icon name="hero-trash-micro" class="size-4" />
        </button>
      </div>
    </div>
  </div>

  <div :if={@upstream_tools != []} class="mt-6">
    <h4 class="text-sm font-semibold text-base-content/70 mb-2">
      Aggregated Tools ({length(@upstream_tools)})
    </h4>
    <div class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden">
      <div :for={tool <- @upstream_tools} class="px-4 py-2 text-sm">
        <div class="font-mono text-xs">{tool["name"]}</div>
        <div class="text-base-content/50 text-xs truncate">{tool["description"]}</div>
      </div>
    </div>
  </div>
</div>

<div class="mt-10">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">Email Inboxes</h3>
    <.link patch={~p"/settings/email-inboxes/new"}>
      <.button class="btn-sm">Add Inbox</.button>
    </.link>
  </div>

  <p class="text-sm text-base-content/60 mb-4">
    IMAP mailboxes polled for inbound email triggers (see the <strong>Triggers</strong>
    page — trigger type <strong>Email</strong>). Polling only ever runs on the hub node.
  </p>

  <div :if={@show_inbox_form} class="card bg-base-200 p-4 mb-6">
    <h4 class="font-semibold mb-3">
      {if @editing_inbox, do: "Edit Email Inbox", else: "Add Email Inbox"}
    </h4>
    <.form for={@inbox_form} phx-submit="save_inbox" phx-change="validate_inbox" class="space-y-3">
      <.input
        field={@inbox_form[:name]}
        type="text"
        label="Name"
        placeholder="ops mailbox"
        phx-debounce="blur"
      />
      <div class="flex gap-2">
        <div class="flex-1">
          <.input
            field={@inbox_form[:host]}
            type="text"
            label="Host"
            placeholder="imap.migadu.com"
            phx-debounce="blur"
          />
        </div>
        <div class="w-28">
          <.input field={@inbox_form[:port]} type="number" label="Port" phx-debounce="blur" />
        </div>
      </div>
      <.input field={@inbox_form[:tls]} type="checkbox" label="Use TLS/SSL" />
      <.input
        field={@inbox_form[:username]}
        type="text"
        label="Username"
        placeholder="orca@ymirtechnology.com"
        autocomplete="off"
        phx-debounce="blur"
      />
      <.input
        field={@inbox_form[:password]}
        type="password"
        label="Password"
        placeholder={if @editing_inbox, do: "Leave blank to keep the current password", else: nil}
        autocomplete="new-password"
        phx-debounce="blur"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        Write-only: stored encrypted, and never shown here again once saved.
        <span :if={@editing_inbox}>Leave blank to keep the current password unchanged.</span>
      </p>
      <.input
        field={@inbox_form[:folder]}
        type="text"
        label="Folder"
        placeholder="INBOX"
        phx-debounce="blur"
      />
      <.input
        field={@inbox_form[:trusted_authserv_id]}
        type="text"
        label="Trusted authserv-id (optional but recommended)"
        placeholder="mx.google.com"
        phx-debounce="blur"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        Pins the authserv-id this inbox will accept in a message's
        <code class="bg-base-300 px-1 rounded">Authentication-Results</code>
        header — set it to the first token (before the first <code>;</code>) of the
        <strong>TOP-MOST</strong>
        <code class="bg-base-300 px-1 rounded">Authentication-Results</code>
        header on a real message you've received in this mailbox (that header is added by your own
        receiving mail server, e.g. <code class="bg-base-300 px-1 rounded">mx.google.com</code>
        for Gmail — never trust a header further down, a sender can forge those). Accepts either an
        <strong>exact host</strong>
        (<code class="bg-base-300 px-1 rounded">mx13.migadu.com</code>) or a
        <strong>domain suffix</strong>
        (<code class="bg-base-300 px-1 rounded">migadu.com</code>, with or without a leading dot) that
        matches any host under it — use a suffix if your provider load-balances inbound mail across
        multiple hosts (e.g. Migadu rotates <code class="bg-base-300 px-1 rounded">mx11</code>/<code class="bg-base-300 px-1 rounded">mx12</code>/<code class="bg-base-300 px-1 rounded">mx13.migadu.com</code>). Leaving this
        blank still requires an aligned <code>dmarc=pass</code>
        or <code>dkim=pass</code>
        to accept any message, but skips this extra pin, which weakens sender authentication.
      </p>
      <.input field={@inbox_form[:enabled]} type="checkbox" label="Enabled" />

      <div class="flex justify-between items-center gap-2 mt-4">
        <button
          type="button"
          phx-click="test_inbox_connection"
          phx-disable-with="Testing…"
          class="btn btn-sm btn-ghost"
        >
          <.icon name="hero-signal-micro" class="size-4" /> Test connection
        </button>
        <div class="flex gap-2">
          <.link patch={~p"/settings"} class="btn btn-sm">Cancel</.link>
          <.button type="submit" class="btn-sm">
            {if @editing_inbox, do: "Update", else: "Add"}
          </.button>
        </div>
      </div>
    </.form>
  </div>

  <div
    :if={@email_inboxes == [] && !@show_inbox_form}
    class="text-sm text-base-content/50 p-8 text-center bg-base-200 rounded-lg"
  >
    No email inboxes configured.
  </div>

  <div
    :if={@email_inboxes != []}
    class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden"
  >
    <div
      :for={inbox <- @email_inboxes}
      class="flex items-center gap-3 px-4 py-3 text-sm hover:bg-base-300/50"
    >
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="font-medium">{inbox.name}</span>
          <span class={[
            "badge badge-xs",
            if(inbox.enabled, do: "badge-success", else: "badge-ghost")
          ]}>
            {if inbox.enabled, do: "enabled", else: "disabled"}
          </span>
          <span :if={inbox.tls} class="badge badge-xs badge-info">TLS</span>
          <span
            :if={!inbox.trusted_authserv_id}
            class="badge badge-xs badge-warning"
            title="No trusted authserv-id pinned — sender authentication is weaker"
          >
            no authserv-id pin
          </span>
        </div>
        <div class="text-base-content/50 text-xs mt-0.5 font-mono">
          {inbox.username}@{inbox.host}:{inbox.port}/{inbox.folder}
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button
          phx-click="toggle_inbox"
          phx-value-id={inbox.id}
          class="btn btn-xs btn-ghost"
          title={if inbox.enabled, do: "Disable", else: "Enable"}
        >
          <.icon
            name={if inbox.enabled, do: "hero-pause-micro", else: "hero-play-micro"}
            class="size-4"
          />
        </button>
        <.link
          patch={~p"/settings/email-inboxes/#{inbox.id}/edit"}
          class="btn btn-xs btn-ghost"
          title="Edit"
        >
          <.icon name="hero-pencil-micro" class="size-4" />
        </.link>
        <button
          phx-click="delete_inbox"
          phx-value-id={inbox.id}
          data-confirm="Delete this email inbox? Any triggers pointed at it will stop firing."
          class="btn btn-xs btn-ghost text-error"
          title="Delete"
        >
          <.icon name="hero-trash-micro" class="size-4" />
        </button>
      </div>
    </div>
  </div>
</div>

<div class="mt-10">
  <h3 class="text-lg font-semibold mb-4">Secrets</h3>

  <p class="text-sm text-base-content/60 mb-4">
    Secrets stored here can be injected into calls to upstream servers with
    <strong>secret injection</strong>
    enabled above (e.g. Playwright). Pass the key name as a literal argument value — the
    real value is substituted server-side and never sent to or returned by the agent.
    Values are <strong>write-only</strong>: once saved, they cannot be viewed again here.
  </p>

  <form phx-submit="add_secret" class="card bg-base-200 p-4 mb-4 flex-row items-end gap-2">
    <div class="flex-1">
      <label class="label"><span class="label-text">Key</span></label>
      <input
        type="text"
        name="key"
        placeholder="PHX_AGENT_PASSWORD"
        autocomplete="off"
        class="input input-sm input-bordered w-full font-mono"
      />
    </div>
    <div class="flex-1">
      <label class="label"><span class="label-text">Value</span></label>
      <input
        type="password"
        name="value"
        autocomplete="new-password"
        class="input input-sm input-bordered w-full"
      />
    </div>
    <.button type="submit" class="btn-sm">Save</.button>
  </form>

  <div
    :if={@secret_keys == []}
    class="text-sm text-base-content/50 p-8 text-center bg-base-200 rounded-lg"
  >
    No secrets stored.
  </div>

  <div
    :if={@secret_keys != []}
    class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden"
  >
    <div
      :for={secret <- @secret_keys}
      class="flex items-center gap-3 px-4 py-3 text-sm hover:bg-base-300/50"
    >
      <div class="flex-1 min-w-0">
        <div class="font-mono font-medium">{secret.key}</div>
        <div class="text-base-content/50 text-xs mt-0.5">
          Updated {secret.updated_at}
        </div>
      </div>
      <button
        phx-click="delete_secret"
        phx-value-key={secret.key}
        data-confirm={"Delete secret #{secret.key}? Sessions using it will fail until it's re-added."}
        class="btn btn-xs btn-ghost text-error"
        title="Delete"
      >
        <.icon name="hero-trash-micro" class="size-4" />
      </button>
    </div>
  </div>
</div>

<div class="mt-10">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">API Tokens</h3>
    <button phx-click="toggle_token_form" class="btn btn-sm">
      {if @show_token_form, do: "Cancel", else: "Add Token"}
    </button>
  </div>

  <p class="text-sm text-base-content/60 mb-4">
    Scoped, revocable tokens for <code class="bg-base-300 px-1 rounded">/api/v1/runs</code>, <code class="bg-base-300 px-1 rounded">/a2a</code>, and other authenticated endpoints — the
    fine-grained alternative to the single global <code class="bg-base-300 px-1 rounded">ORCA_API_TOKEN</code>.
    Only a hash of the secret is ever stored; the plaintext is shown <strong>once</strong>,
    immediately after creation, and cannot be recovered afterward.
  </p>

  <div :if={@revealed_secret} class="alert alert-warning mb-6 flex-col items-start gap-2">
    <div class="font-semibold">
      Token "{@revealed_secret.name}" created — copy this secret now
    </div>
    <div class="text-sm">
      This is the only time the secret will ever be shown. It is not stored anywhere in
      recoverable form — if you lose it, revoke this token and create a new one.
    </div>
    <div class="flex items-center gap-2 w-full">
      <code
        id="revealed-token-secret"
        class="bg-base-100 px-2 py-1.5 rounded text-xs font-mono flex-1 overflow-x-auto whitespace-nowrap"
      >
        {@revealed_secret.secret}
      </code>
      <button
        type="button"
        class="btn btn-xs"
        onclick="navigator.clipboard.writeText(document.getElementById('revealed-token-secret').textContent)"
      >
        <.icon name="hero-clipboard-document-micro" class="size-4" /> Copy
      </button>
      <button type="button" phx-click="dismiss_secret" class="btn btn-xs btn-ghost">
        Dismiss
      </button>
    </div>
  </div>

  <div :if={@show_token_form} class="card bg-base-200 p-4 mb-6">
    <h4 class="font-semibold mb-3">Add API Token</h4>
    <.form for={@token_form} phx-submit="save_token" phx-change="validate_token" class="space-y-3">
      <.input
        field={@token_form[:name]}
        type="text"
        label="Name"
        placeholder="ci-runner"
        phx-debounce="blur"
      />

      <div>
        <label class="label"><span class="label-text">Scopes</span></label>
        <input type="hidden" name="api_token[scopes][]" value="" />
        <div class="flex flex-wrap gap-4">
          <label
            :for={scope <- token_scopes()}
            class="flex items-center gap-2 text-sm cursor-pointer"
          >
            <input
              type="checkbox"
              name="api_token[scopes][]"
              value={scope}
              checked={scope in (@token_form[:scopes].value || [])}
              class="checkbox checkbox-sm"
            />
            <code class="text-xs">{scope}</code>
          </label>
        </div>
        <div
          :for={msg <- Enum.map(@token_form[:scopes].errors, &translate_error/1)}
          class="mt-1.5 flex gap-2 items-center text-sm text-error"
        >
          <.icon name="hero-exclamation-circle" class="size-4" /> {msg}
        </div>
      </div>

      <.input
        field={@token_form[:session_id]}
        type="text"
        label="Pin to session (optional)"
        placeholder="Session UUID — leave blank for an unpinned token"
        phx-debounce="blur"
      />
      <p class="text-xs text-base-content/50 -mt-2">
        A session-pinned token can only act on that one session, and cannot hold the
        <code class="bg-base-300 px-1 rounded">tts</code>
        or <code class="bg-base-300 px-1 rounded">a2a</code>
        scope (neither takes a session_id).
      </p>

      <.input
        field={@token_form[:expires_at]}
        type="datetime-local"
        label="Expires (optional)"
      />

      <div class="flex justify-end gap-2 mt-4">
        <button type="button" phx-click="cancel_token_form" class="btn btn-sm">Cancel</button>
        <.button type="submit" class="btn-sm">Create</.button>
      </div>
    </.form>
  </div>

  <div
    :if={@api_tokens == [] && !@show_token_form}
    class="text-sm text-base-content/50 p-8 text-center bg-base-200 rounded-lg"
  >
    No API tokens configured.
  </div>

  <div
    :if={@api_tokens != []}
    class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden"
  >
    <div
      :for={token <- @api_tokens}
      class="flex items-center gap-3 px-4 py-3 text-sm hover:bg-base-300/50"
    >
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
          <span class={["font-medium", token.revoked_at && "line-through text-base-content/40"]}>
            {token.name}
          </span>
          <code class="text-xs text-base-content/50">{token.token_prefix}…</code>
          <span :if={token.revoked_at} class="badge badge-xs badge-error">revoked</span>
          <span
            :if={
              !token.revoked_at && token.expires_at &&
                DateTime.compare(DateTime.utc_now(), token.expires_at) == :gt
            }
            class="badge badge-xs badge-warning"
          >
            expired
          </span>
          <span :for={scope <- token.scopes} class="badge badge-xs badge-neutral font-mono">
            {scope}
          </span>
        </div>
        <div class="text-base-content/50 text-xs mt-0.5">
          <span :if={token.session_id}>
            Pinned to session
            <.link navigate={~p"/sessions/#{token.session_id}"} class="link font-mono">
              {String.slice(token.session_id, 0, 8)}
            </.link>
          </span>
          <span :if={!token.session_id}>Unpinned</span>
          · Created {token.inserted_at} · Last used {token.last_used_at || "never"} · Expires {token.expires_at ||
            "never"}
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button
          :if={!token.revoked_at}
          phx-click="revoke_token"
          phx-value-id={token.id}
          data-confirm={"Revoke token \"#{token.name}\"? Anything using it will stop working immediately."}
          class="btn btn-xs btn-ghost text-error"
          title="Revoke"
        >
          <.icon name="hero-no-symbol-micro" class="size-4" />
        </button>
      </div>
    </div>
  </div>
</div>

<div class="mt-10">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">Cluster Code Sync</h3>
    <div class="flex gap-2">
      <button phx-click="check_drift" class="btn btn-sm btn-ghost" title="Check for code drift">
        <.icon name="hero-magnifying-glass-micro" class="size-4" /> Check Drift
      </button>
      <button
        phx-click="push_changed_code"
        class="btn btn-sm btn-ghost"
        disabled={@code_sync_loading}
      >
        <.icon name="hero-arrow-up-tray-micro" class="size-4" /> Push Changed
      </button>
      <button
        phx-click="push_all_code"
        class="btn btn-sm btn-primary"
        disabled={@code_sync_loading}
      >
        <.icon name="hero-arrow-up-tray-micro" class="size-4" /> Push All
      </button>
    </div>
  </div>

  <p class="text-sm text-base-content/60 mb-4">
    Hot-load compiled beam files from this node onto remote agent nodes without restarting.
  </p>

  <div :if={@code_sync_loading} class="flex items-center gap-2 text-sm text-base-content/60 mb-4">
    <span class="loading loading-spinner loading-sm"></span> Pushing code...
  </div>

  <%!-- Result display --%>
  <div :if={@code_sync_result && !@code_sync_loading} class="mb-4">
    <div class={[
      "alert text-sm",
      if(@code_sync_result[:errors] == [], do: "alert-success", else: "alert-warning")
    ]}>
      <div>
        <div>
          Pushed <strong>{@code_sync_result.modules_pushed}</strong>
          modules
          to <strong>{@code_sync_result.nodes_updated}</strong>
          node(s).
          <%= if @code_sync_result[:skipped] do %>
            <span class="text-base-content/60">({@code_sync_result.skipped})</span>
          <% end %>
        </div>
        <div :if={@code_sync_result[:errors] != []} class="mt-1 text-xs text-error">
          <div :for={err <- @code_sync_result.errors}>{err}</div>
        </div>
      </div>
    </div>
  </div>

  <%!-- Connected nodes --%>
  <div class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden">
    <div class="px-4 py-2 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
      Connected Nodes ({length(@cluster_nodes)})
    </div>
    <div
      :for={info <- @cluster_nodes}
      class="flex items-center gap-3 px-4 py-3 text-sm hover:bg-base-300/50"
    >
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <% node_record = Map.get(@node_records, info.node) %>
          <.link
            :if={node_record}
            navigate={~p"/nodes/#{node_record.id}"}
            class="font-medium hover:underline"
          >
            {info.name}
          </.link>
          <span :if={!node_record} class="font-medium">{info.name}</span>
          <span :if={info.node == node()} class="badge badge-xs badge-primary">this node</span>
          <span :if={info.node != node()} class="badge badge-xs badge-success">connected</span>
        </div>
        <div class="text-base-content/50 text-xs mt-0.5 font-mono">{info.node}</div>
      </div>
      <div class="flex items-center gap-1 flex-wrap justify-end">
        <button
          :if={info.node != node()}
          phx-click="push_to_node"
          phx-value-node={info.node}
          class="btn btn-xs btn-ghost"
          title="Push code to this node"
          disabled={@code_sync_loading}
        >
          <.icon name="hero-arrow-up-tray-micro" class="size-4" />
        </button>
        <button
          :if={info.node != node()}
          phx-click="restart_supervisor"
          phx-value-node={info.node}
          phx-value-supervisor="OrcaHub.SessionSupervisor"
          data-confirm={"Restart SessionSupervisor on #{info.name}? This will stop all running sessions on that node."}
          class="btn btn-xs btn-ghost text-warning"
          title="Restart SessionSupervisor"
        >
          <.icon name="hero-arrow-path-micro" class="size-4" />
        </button>
      </div>
    </div>
    <div :if={length(@cluster_nodes) <= 1} class="px-4 py-3 text-sm text-base-content/50">
      No remote nodes connected.
    </div>
  </div>

  <%!-- Drift check results --%>
  <div :if={@drift_results} class="mt-4">
    <h4 class="text-sm font-semibold text-base-content/70 mb-2">Code Drift Report</h4>
    <div class="bg-base-200 rounded-lg divide-y divide-base-300 overflow-hidden">
      <div :for={dr <- @drift_results} class="px-4 py-3 text-sm">
        <div class="flex items-center gap-2 mb-1">
          <span class="font-medium font-mono text-xs">{dr.node}</span>
          <span :if={dr.drifted == [] && dr.missing == []} class="badge badge-xs badge-success">
            in sync
          </span>
          <span :if={dr.drifted != [] || dr.missing != []} class="badge badge-xs badge-warning">
            {length(dr.drifted)} drifted, {length(dr.missing)} missing
          </span>
        </div>
        <div :if={dr.drifted != []} class="text-xs text-base-content/60 mt-1">
          Drifted: {dr.drifted |> Enum.map(&inspect/1) |> Enum.join(", ")}
        </div>
        <div :if={dr.missing != []} class="text-xs text-base-content/60 mt-1">
          Missing: {dr.missing |> Enum.map(&inspect/1) |> Enum.join(", ")}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="mt-10">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-semibold">Pi Config</h3>
    <.link navigate={~p"/settings/pi-config"}>
      <.button class="btn-sm">Configure Pi</.button>
    </.link>
  </div>

  <p class="text-sm text-base-content/60 mb-4">
    Manage Pi agent configuration entries (providers, settings, extensions, prompts, themes).
    Hub-managed entries are synced to every node's disk on the next sync cycle.
  </p>
</div>
