<.header>
  Issues
</.header>

<div class="flex flex-wrap items-center gap-4 mt-4">
  <div class="flex gap-1">
    <button
      :for={{label, value} <- kind_filters()}
      phx-click="set_kind_filter"
      phx-value-kind={value}
      class={["btn btn-sm", @kind_filter == value && "btn-active"]}
    >
      {label}
    </button>
  </div>
  <div class="flex gap-1">
    <button
      :for={{label, value} <- status_filters()}
      phx-click="set_status_filter"
      phx-value-status={value}
      class={["btn btn-sm", @status_filter == value && "btn-active"]}
    >
      {label}
    </button>
  </div>
</div>

<.grouped_index
  id="issues"
  groups={@groups}
  pinned={@pinned}
  row_click={fn issue -> JS.navigate(~p"/issues/#{issue_key(issue) || issue.id}") end}
>
  <:col :let={issue} label="Pin" class="w-8">
    <button
      :if={is_nil(issue.pinned_at)}
      type="button"
      phx-click="pin"
      phx-value-id={issue.id}
      class="btn btn-ghost btn-xs btn-circle"
      title="Pin"
    >
      <.icon name="hero-star" class="size-4 text-base-content/40" />
    </button>
    <button
      :if={not is_nil(issue.pinned_at)}
      type="button"
      phx-click="unpin"
      phx-value-id={issue.id}
      class="btn btn-ghost btn-xs btn-circle"
      title="Unpin"
    >
      <.icon name="hero-star-solid" class="size-4 text-warning" />
    </button>
  </:col>
  <:col :let={issue} label="Key" class="w-2/5">
    <span class={["font-mono text-xs", issue.status in ["closed", "abandoned"] && "opacity-50"]}>
      {issue_key(issue) || "—"}
    </span>
  </:col>
  <:col :let={issue} label="Title" class="w-2/5">
    <.link
      navigate={~p"/issues/#{issue_key(issue) || issue.id}"}
      class={[
        "link link-hover",
        issue.status in ["closed", "abandoned"] && "opacity-50"
      ]}
    >
      {issue.title}
    </.link>
  </:col>
  <:col :let={issue} label="Kind" class="w-1/5">
    <span class={[
      "badge badge-sm",
      issue.kind == "feature_request" && "badge-secondary",
      issue.kind == "task" && "badge-ghost",
      issue.status in ["closed", "abandoned"] && "opacity-50"
    ]}>
      {issue.kind}
    </span>
  </:col>
  <:col :let={issue} label="Status" class="w-1/5">
    <span class={[
      "badge badge-sm",
      issue.status == "open" && "badge-info",
      issue.status == "in_progress" && "badge-warning",
      issue.status == "closed" && "badge-success opacity-60",
      issue.status == "abandoned" && "badge-neutral opacity-60"
    ]}>
      {issue.status}
    </span>
  </:col>
  <:col :let={issue} label="Filed" class="whitespace-nowrap text-xs text-base-content/60">
    <span class={issue.status in ["closed", "abandoned"] && "opacity-50"}>
      {Calendar.strftime(issue.inserted_at, "%Y-%m-%d %H:%M")}
    </span>
  </:col>
</.grouped_index>

<div :if={@groups == [] && @pinned == []} class="text-sm text-base-content/50 p-4 text-center">
  No issues match this filter.
</div>
