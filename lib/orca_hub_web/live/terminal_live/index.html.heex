<.header>
  Terminals
  <:actions>
    <.link patch={~p"/terminals/new"}>
      <.button>New Terminal</.button>
    </.link>
  </:actions>
</.header>

<div :if={@show_form} class="card bg-base-200 p-4 mt-6">
  <h4 class="font-semibold mb-3">New Terminal</h4>
  <.form
    for={@terminal_form}
    phx-submit="save_terminal"
    phx-change="validate_terminal"
    class="space-y-3"
  >
    <.input
      field={@terminal_form[:name]}
      type="text"
      label="Name"
      placeholder="backend server"
      phx-hook="AutoFocus"
    />
    <.input
      field={@terminal_form[:project_id]}
      type="select"
      label="Project"
      prompt="(none)"
      options={Enum.map(@projects, &{&1.name, &1.id})}
    />
    <.input
      field={@terminal_form[:directory]}
      type="text"
      label="Directory"
      placeholder="Leave blank to use project directory"
    />
    <.input field={@terminal_form[:shell]} type="text" label="Shell" value="/bin/bash" />
    <div class="flex justify-end gap-2">
      <.link patch={~p"/terminals"} class="btn btn-sm">Cancel</.link>
      <.button type="submit" class="btn-sm">Create</.button>
    </div>
  </.form>
</div>

<div
  :if={@terminals == [] && !@show_form}
  class="text-sm text-base-content/50 p-8 text-center mt-6"
>
  No terminals yet.
</div>

<div :if={@terminals != []} class="mt-6">
  <.grouped_index
    id="terminals"
    groups={@grouped_terminals}
    pinned={@pinned_terminals}
    row_click={fn terminal -> JS.navigate(~p"/terminals/#{terminal.id}") end}
  >
    <:col :let={terminal} label="" class="w-8">
      <button
        type="button"
        phx-click={if terminal.pinned_at, do: "unpin", else: "pin"}
        phx-value-id={terminal.id}
        class="btn btn-ghost btn-xs btn-circle"
        title={if terminal.pinned_at, do: "Unpin", else: "Pin"}
      >
        <.icon
          name={if terminal.pinned_at, do: "hero-star-solid", else: "hero-star"}
          class={
            if terminal.pinned_at, do: "size-4 text-warning", else: "size-4 text-base-content/40"
          }
        />
      </button>
    </:col>
    <:col :let={terminal} label="Name" class="w-1/4">
      <span class="font-medium">{terminal.name}</span>
      <span class="badge badge-xs ml-1">
        {terminal.status}
      </span>
      <span
        :if={@clustered && Map.get(@node_map, terminal.id)}
        class="badge badge-xs badge-outline ml-1 opacity-60"
      >
        {Map.get(@node_names, Map.get(@node_map, terminal.id))}
      </span>
    </:col>
    <:col :let={terminal} label="Directory" class="hidden md:table-cell font-mono truncate">
      {terminal.directory}
    </:col>
    <:col :let={terminal} label="Status" class="w-1/5">
      <span class="badge badge-sm">
        <span
          class="inline-block w-2 h-2 rounded-full mr-1.5"
          style={terminal_status_color(terminal.status)}
        />
        {terminal.status}
      </span>
    </:col>
    <:action :let={terminal}>
      <button
        :if={terminal.status != "running"}
        phx-click="start_terminal"
        phx-value-id={terminal.id}
        class="btn btn-ghost btn-xs"
        title="Start"
      >
        <.icon name="hero-play-micro" class="size-4" />
      </button>
      <button
        :if={terminal.status == "running"}
        phx-click="stop_terminal"
        phx-value-id={terminal.id}
        class="btn btn-ghost btn-xs"
        title="Stop"
      >
        <.icon name="hero-stop-micro" class="size-4" />
      </button>
      <button
        phx-click="delete_terminal"
        phx-value-id={terminal.id}
        data-confirm="Delete this terminal?"
        class="btn btn-ghost btn-xs text-error"
        title="Delete"
      >
        <.icon name="hero-trash-micro" class="size-4" />
      </button>
    </:action>
  </.grouped_index>
</div>
