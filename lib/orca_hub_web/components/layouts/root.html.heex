<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="OrcaHub">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/vendor/xterm.css"} />
    <style>
      pre:has(> code.mermaid), pre:has(> code.language-mermaid) { visibility: hidden; height: 0; overflow: hidden; }
    </style>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";
      mermaid.initialize({ startOnLoad: false, theme: "dark" });

      let pending = null;
      function renderMermaidBlocks() {
        if (pending) return;
        pending = requestAnimationFrame(() => {
          pending = null;
          const nodes = [];
          document.querySelectorAll("pre > code.mermaid, pre > code.language-mermaid").forEach((codeEl) => {
            const pre = codeEl.parentElement;
            if (pre.dataset.mermaidRendered) return;
            pre.dataset.mermaidRendered = "true";

            const container = document.createElement("div");
            container.className = "mermaid";
            container.textContent = codeEl.textContent;
            pre.replaceWith(container);
            nodes.push(container);
          });
          if (nodes.length > 0) {
            mermaid.run({ nodes });
          }
        });
      }

      // Render on initial load and after LiveView DOM patches
      renderMermaidBlocks();
      new MutationObserver(renderMermaidBlocks).observe(document.body, {
        childList: true,
        subtree: true,
      });
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
    <script>
      // The session page's `lg:` sidebar (SessionLive.Sidebar), collapsed or
      // not. Same shape as the theme above: an attribute on <html>, outside
      // every LiveView root, applied here before first paint so a collapsed
      // sidebar never flashes open. Each state stores only its non-default
      // value (the `sidebar-collapsed:` variant in app.css reads both).
      (() => {
        const states = {
          chat: { key: "orca:session-sidebar", attr: "data-session-sidebar", value: "collapsed" },
          panel: { key: "orca:session-sidebar-panel", attr: "data-session-sidebar-panel", value: "expanded" },
        };
        const root = document.documentElement;
        const apply = (s, v) => (v === s.value ? root.setAttribute(s.attr, v) : root.removeAttribute(s.attr));
        for (const s of Object.values(states)) apply(s, localStorage.getItem(s.key));
        window.addEventListener("storage", (e) => {
          for (const s of Object.values(states)) if (e.key === s.key) apply(s, e.newValue);
        });
        // Dispatched by the sidebar's collapse/expand buttons. Their aside's
        // `data-sidebar-context` says which of the two states they flip.
        window.addEventListener("orca:session-sidebar-toggle", (e) => {
          const ctx = e.target.closest && e.target.closest("[data-sidebar-context]");
          const s = states[ctx && ctx.dataset.sidebarContext] || states.chat;
          const next = root.getAttribute(s.attr) === s.value ? null : s.value;
          apply(s, next);
          next ? localStorage.setItem(s.key, next) : localStorage.removeItem(s.key);
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
